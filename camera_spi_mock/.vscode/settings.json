{
    "cmake.cmakePath": "cube-cmake",
    "cmake.configureArgs": [
        "-DCMAKE_COMMAND=cube-cmake"
    ],
    "cmake.environment": {
        "CUBE_BUNDLE_PATH": "D:\\STM32Cube\\bundles",
        "TEMP": "D:\\Temp",
        "TMP": "D:\\Temp"
    },
    "cmake.preferredGenerators": [
        "Ninja"
    ],
