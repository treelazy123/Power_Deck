    "stm32cube-ide-clangd.arguments": [
        "starm-clangd",
        "--query-driver=D:/STM32Cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gcc*",
        "--query-driver=D:/STM32Cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-g++*"
    ]
}
